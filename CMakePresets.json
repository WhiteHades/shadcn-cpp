{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name":"dev", "generator":"Ninja", "binaryDir":"${sourceDir}/build/dev", "cacheVariables":{"CMAKE_BUILD_TYPE":"Debug", "CMAKE_EXPORT_COMPILE_COMMANDS":"ON"}},
    {"name":"core", "inherits":"dev", "binaryDir":"${sourceDir}/build/core", "cacheVariables":{"SHADCN_BUILD_WIDGETS":"OFF", "SHADCN_BUILD_EXAMPLES":"OFF", "SHADCN_WARNINGS_AS_ERRORS":"ON"}},
    {"name":"asan", "inherits":"dev", "binaryDir":"${sourceDir}/build/asan", "cacheVariables":{"SHADCN_SANITIZERS":"ON"}},
    {"name":"core-asan", "inherits":"core", "binaryDir":"${sourceDir}/build/core-asan", "cacheVariables":{"SHADCN_SANITIZERS":"ON"}}
  ],
  "buildPresets":[{"name":"dev","configurePreset":"dev"},{"name":"core","configurePreset":"core"},{"name":"asan","configurePreset":"asan"},{"name":"core-asan","configurePreset":"core-asan"}],
  "testPresets":[{"name":"dev","configurePreset":"dev","output":{"outputOnFailure":true}},{"name":"core","configurePreset":"core","output":{"outputOnFailure":true}},{"name":"asan","configurePreset":"asan","output":{"outputOnFailure":true}},{"name":"core-asan","configurePreset":"core-asan","output":{"outputOnFailure":true}}]
}
